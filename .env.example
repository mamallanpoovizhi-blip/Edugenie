GEMINI_API_KEY=your_google_gemini_api_key_here
# Primary current Gemini model.
GEMINI_MODEL=gemini-3.5-flash
# Optional comma-separated fallback models for temporary 503/429 errors.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# Hugging Face model used by the local explanation module.
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M
